# Copy to .env and fill in values: cp .env.example .env
# Never commit .env to git

TK_DB_USER=tropek
TK_DB_PASSWORD=change-me
TK_REDIS_PASSWORD=change-me
# generate with: openssl rand -hex 32
TK_SECRET_KEY=change-me

# Optional — API process count and its PER-PROCESS DB pool (defaults shown). Keep
# workers x (pool + overflow) + the worker's 30 under Postgres max_connections (100 default).
# TK_API_WORKERS=4
# TK_API_DB_POOL_SIZE=5
# TK_API_DB_MAX_OVERFLOW=5

# Optional — only needed if you run the Prometheus adapter against a real Prometheus
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=

# Shared secret the API presents to the adapter's query endpoints. Leave empty to keep them
# unauthenticated. Set the SAME value as the `token` on the datasource you register for this
# adapter. Generate with: openssl rand -hex 32
ADAPTER_AUTH_TOKEN=
